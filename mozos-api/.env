# Copiá este archivo como .env y completá los valores

# Servidor
PORT=3000
NODE_ENV=development

# JWT — cambiá estos valores por strings largos y aleatorios en producción
JWT_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio_minimo_32_chars
JWT_EXPIRES_IN=7d

JWT_ADMIN_SECRET=otro_secreto_diferente_para_admins_minimo_32_chars
JWT_ADMIN_EXPIRES_IN=1d

# Base de datos
DB_PATH=./data/mozos.db

# Anti-spam: horas mínimas entre reseñas del mismo usuario
RESENA_COOLDOWN_HORAS=4

# CORS — origen del frontend
FRONTEND_URL=http://localhost:5173
